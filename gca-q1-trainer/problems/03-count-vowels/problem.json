{
  "id": 3,
  "slug": "count-vowels",
  "title": "Count Vowels",
  "difficulty": "easy",
  "topic": "String charAt loop",
  "statement": "Given a string `s`, return the number of vowels in it. The vowels are `a`, `e`, `i`, `o`, `u`, in either lower or upper case. All other characters (including `y`) are not vowels.",
  "returnType": "int",
  "params": [
    {
      "type": "String",
      "name": "s"
    }
  ],
  "examples": [
    {
      "args": [
        "CodeSignal"
      ],
      "expected": 4,
      "explanation": "o, e, i and a are vowels."
    },
    {
      "args": [
        "Programming is fun"
      ],
      "expected": 5,
      "explanation": "o, a, i (Programming), i (is), u (fun)."
    }
  ],
  "constraints": [
    "1 <= s.length() <= 100",
    "s consists of printable ASCII characters"
  ],
  "visible": [
    {
      "args": [
        "hello"
      ],
      "expected": 2
    },
    {
      "args": [
        "rhythm"
      ],
      "expected": 0
    },
    {
      "args": [
        "banana"
      ],
      "expected": 3
    }
  ],
