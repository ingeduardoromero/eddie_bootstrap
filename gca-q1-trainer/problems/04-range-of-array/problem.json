{
  "id": 4,
  "slug": "range-of-array",
  "title": "Range of Array",
  "difficulty": "standard",
  "topic": "min/max tracking",
  "statement": "Given a non-empty array of integers `a`, return the difference between its largest and smallest elements (`max - min`).",
  "returnType": "int",
  "params": [
    {
      "type": "int[]",
      "name": "a"
    }
  ],
  "examples": [
    {
      "args": [
        [
          6,
          -1,
          2
        ]
      ],
      "expected": 7,
      "explanation": "max = 6, min = -1, so 6 - (-1) = 7."
    },
    {
      "args": [
        [
          -8,
          -3,
          4
        ]
      ],
      "expected": 12,
      "explanation": "4 - (-8) = 12."
    }
  ],
  "constraints": [
    "1 <= a.length <= 100",
    "-10^9 <= a[i] <= 10^9"
  ],
  "visible": [
