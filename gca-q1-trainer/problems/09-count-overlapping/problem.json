{
  "id": 9,
  "slug": "count-overlapping",
  "title": "Count Overlapping",
  "difficulty": "tricky",
  "topic": "indexOf / substring",
  "statement": "Given strings `s` and `p`, return how many times `p` occurs in `s`, counting occurrences that overlap. Matching is case-sensitive.\n\nFor example, `\"aa\"` occurs 3 times in `\"aaaa\"`.",
  "returnType": "int",
  "params": [
    {
      "type": "String",
      "name": "s"
    },
    {
      "type": "String",
      "name": "p"
    }
  ],
  "examples": [
    {
      "args": [
        "aaaa",
        "aa"
      ],
      "expected": 3,
      "explanation": "Matches start at indices 0, 1 and 2."
    },
    {
      "args": [
        "banana",
        "ana"
      ],
      "expected": 2,
      "explanation": "Matches start at indices 1 and 3 and share the middle 'a'."
    }
  ],
  "constraints": [
    "1 <= s.length() <= 100",
    "1 <= p.length() <= 100",
    "s and p contain only English letters (a-z, A-Z)"
  ],
  "visible": [
