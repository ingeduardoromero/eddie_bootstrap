{
  "id": 5,
  "slug": "reverse-number",
  "title": "Reverse Number",
  "difficulty": "standard",
  "topic": "digit building by append",
  "statement": "Given a non-negative integer `n`, return the number formed by writing its decimal digits in reverse order. Leading zeros of the result are dropped, since the result is an ordinary integer.\n\nFor example, 123 becomes 321 and 120 becomes 21.",
  "returnType": "int",
  "params": [
    {
      "type": "int",
      "name": "n"
    }
  ],
  "examples": [
    {
      "args": [
        120
      ],
      "expected": 21,
      "explanation": "Reversed digits are 021, which is the number 21."
    },
    {
      "args": [
        9081
      ],
      "expected": 1809,
      "explanation": "Digits 9,0,8,1 reversed are 1,8,0,9."
    }
  ],
  "constraints": [
    "0 <= n <= 10^9"
  ],
