{
  "id": 2,
  "slug": "count-divisible",
  "title": "Count Divisible",
  "difficulty": "easy",
  "topic": "loop, condition, counter",
  "statement": "Given an array of integers `a` and a positive integer `k`, return how many elements of `a` are divisible by `k`.\n\nAn element `x` is divisible by `k` if `x % k == 0`. Zero is divisible by every positive `k`, and negative numbers can be divisible too.",
  "returnType": "int",
  "params": [
    {
      "type": "int[]",
      "name": "a"
    },
    {
      "type": "int",
      "name": "k"
    }
  ],
  "examples": [
    {
      "args": [
        [
          2,
          4,
          5,
          8
        ],
        2
      ],
      "expected": 3,
      "explanation": "2, 4 and 8 are divisible by 2."
    },
    {
      "args": [
        [
          7,
          14,
          21
        ],
        7
      ],
      "expected": 3,
      "explanation": "Every element is a multiple of 7."
    }
  ],
  "constraints": [
    "1 <= a.length <= 100",
    "-10^9 <= a[i] <= 10^9",
    "1 <= k <= 10^9"
  ],
