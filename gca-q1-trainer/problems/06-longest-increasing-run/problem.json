{
  "id": 6,
  "slug": "longest-increasing-run",
  "title": "Longest Increasing Run",
  "difficulty": "standard",
  "topic": "Adjacent comparison",
  "statement": "Given an array of integers `a`, return the length of the longest contiguous run in which every element is strictly greater than the one before it.\n\nA single element is a run of length 1.",
  "returnType": "int",
  "params": [
    {
      "type": "int[]",
      "name": "a"
    }
  ],
  "examples": [
    {
      "args": [
        [
          1,
          2,
          2,
          3
        ]
      ],
      "expected": 2,
      "explanation": "The runs are [1,2] and [2,3], both of length 2."
    },
    {
      "args": [
        [
          10,
          20,
          30,
          40
        ]
      ],
      "expected": 4,
      "explanation": "The whole array is strictly increasing."
    }
  ],
  "constraints": [
    "1 <= a.length <= 100",
    "-10^9 <= a[i] <= 10^9"
  ],
