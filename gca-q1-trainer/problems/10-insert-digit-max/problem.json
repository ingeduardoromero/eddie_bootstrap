{
  "id": 10,
  "slug": "insert-digit-max",
  "title": "Insert Digit Max",
  "difficulty": "tricky",
  "topic": "Place-value building / negatives",
  "statement": "Given an integer `n` (possibly negative) and a digit `d`, insert `d` somewhere into the decimal representation of `n` (before the first digit, between digits, or after the last) to make the largest possible number. You may not remove or reorder digits, and for a negative number the minus sign stays in front.\n\nReturn the result as a long.\n\nFor example, inserting 6 into 73 gives 763, and inserting 3 into -132 gives -1323.",
  "returnType": "long",
  "params": [
    {
      "type": "int",
      "name": "n"
    },
    {
      "type": "int",
      "name": "d"
    }
  ],
  "examples": [
    {
      "args": [
        73,
        6
      ],
      "expected": 763,
      "explanation": "Options: 673, 763, 736. The largest is 763."
    },
    {
      "args": [
        -132,
        3
      ],
      "expected": -1323,
      "explanation": "Options: -3132, -1332, -1323, -1323. The largest (closest to zero) is -1323."
    }
  ],
  "constraints": [
    "-10^9 <= n <= 10^9",
    "0 <= d <= 9"
  ],
